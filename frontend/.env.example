# Backend API Service URL (When backend is deployed separately on Render)
# Leave blank for local development or same-domain proxy
# Example for Render deployment: VITE_BACKEND_URL=https://xbuddy-backend.onrender.com
VITE_BACKEND_URL=

# Local Print Agent Base URL (Defaults to http://localhost:3001)
VITE_PRINT_AGENT_URL=http://localhost:3001

# Cloudflare Tunnel Registry (GitHub Raw fallback)
VITE_GITHUB_TUNNEL_URL=https://raw.githubusercontent.com/xbuddysrkr/xbuddy/main/public/tunnel-url.txt

# Google Apps Script Web App Endpoint (For Campus Ads & Tunnel Discovery)
VITE_GAS_URL=https://script.google.com/macros/s/AKfycbxKJmtKejQsYy7zsYmUDVwKJ821szraMUT3BeZK0xEYpnmMWmhAzUvNrTbUMR_grRS0/exec
VITE_API_KEY=XB_API_SECRET_KEY_2026

# Admin & Shopkeeper Dashboard Access Password
VITE_ADMIN_PASSWORD=xbuddy@4921

# Xerox Shop Official UPI ID & Payee Name (Used for student UPI QR generation)
VITE_UPI_ID=xbuddy@upi
VITE_PAYEE_NAME=Xerox Buddy

# Custom UPI ID for Google Pay
VITE_GPAY_UPI_ID=sreekarthota2007@okaxis

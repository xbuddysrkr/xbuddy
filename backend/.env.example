# ==============================================================================
# X BUDDY — BACKEND ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# ==============================================================================

# MongoDB Atlas Connection URI (Primary & Authoritative Store)
# NOTE: Set privately in Vercel Project Settings for production
MONGODB_URI=mongodb+srv://xbuddy_app_user:<password>@xbuddycluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=xbuddy

# Orders Storage Mode ('mongo' = authoritative Atlas store, 'dual' = dual-write recovery, 'gas' = legacy)
ORDERS_STORAGE_MODE=mongo

# Shared Secret for Authenticated Agent Endpoints
AGENT_SECRET=xbuddy_agent_secret_prod_2026

# Google Apps Script API Key (For Campus Ads and Frozen Orders Archive)
GAS_API_KEY=XB_API_SECRET_KEY_2026
GAS_ORDERS_URL=https://script.google.com/macros/s/AKfycbxKJmtKejQsYy7zsYmUDVwKJ821szraMUT3BeZK0xEYpnmMWmhAzUvNrTbUMR_grRS0/exec

# Local Print Agent Port
PORT=3001

# ==============================================================================
# X BUDDY — BACKEND ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & PORT CONFIGURATION
# ------------------------------------------------------------------------------
# Primary Express/Render server port (hosts /health, /api/orders, /api/agent/orders)
PORT=3000

# Local Print Agent Express server port (running on physical kiosk machine)
PRINT_AGENT_PORT=3001

# Allowed origins for CORS (comma-separated or * for public cloud deployment)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# ------------------------------------------------------------------------------
# 2. MONGODB ATLAS (AUTHORITATIVE PRIMARY DATABASE)
# ------------------------------------------------------------------------------
# MongoDB connection URI (Atlas production connection string)
# Configure secretly in Render / Vercel environment settings
MONGODB_URI=mongodb+srv://<username>:<password>@xbuddycluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=xbuddy

# Orders Storage Mode ('mongo' = authoritative Atlas store, 'dual' = dual-write recovery, 'gas' = legacy)
ORDERS_STORAGE_MODE=mongo

# ------------------------------------------------------------------------------
# 3. CLOUDFLARE TUNNEL (REMOTE MOBILE-TO-KIOSK PRINT PIPELINE)
# ------------------------------------------------------------------------------
# Active ephemeral Cloudflare Quick Tunnel URL or named Cloudflare Tunnel URL
CLOUDFLARE_TUNNEL_URL=https://<your-subdomain>.trycloudflare.com

# Local URL that cloudflared proxies traffic to
TUNNEL_TARGET_URL=http://localhost:3001

# Cloudflare tunnel execution log file
TUNNEL_LOG_FILE=tunnel.log

# Google Apps Script endpoint used by Print Agent to publish live tunnel URL
GAS_TUNNEL_URL=https://script.google.com/macros/s/AKfycbxKJmtKejQsYy7zsYmUDVwKJ821szraMUT3BeZK0xEYpnmMWmhAzUvNrTbUMR_grRS0/exec

# Root repository directory for auto-committing public/tunnel-url.txt to GitHub
GITHUB_REPO_DIR=F:\xerox buddy

# ------------------------------------------------------------------------------
# 4. PRINT AGENT & AUTHENTICATION SECRETS
# ------------------------------------------------------------------------------
# Primary Cloud API endpoint used by Print Agent to poll MongoDB orders
CLOUD_API_URL=https://xbuddysrkr.vercel.app

# Shared Secret for Authenticated Agent Endpoints (/api/agent/orders)
AGENT_SECRET=xbuddy_agent_secret_prod_2026
AGENT_SECRET_KEY=xbuddy_agent_secret_prod_2026

# Shopkeeper / Booth Station Operator 4-digit PIN for /booth-login
BOOTH_PIN=4921

# ------------------------------------------------------------------------------
# 5. GOOGLE APPS SCRIPT & HISTORICAL ARCHIVE
# ------------------------------------------------------------------------------
# Google Apps Script API Secret Key
GAS_API_KEY=XB_API_SECRET_KEY_2026
API_KEY=XB_API_SECRET_KEY_2026

# Google Apps Script Web App Deployment URL
GAS_URL=https://script.google.com/macros/s/AKfycbxKJmtKejQsYy7zsYmUDVwKJ821szraMUT3BeZK0xEYpnmMWmhAzUvNrTbUMR_grRS0/exec
GAS_ORDERS_URL=https://script.google.com/macros/s/AKfycbxKJmtKejQsYy7zsYmUDVwKJ821szraMUT3BeZK0xEYpnmMWmhAzUvNrTbUMR_grRS0/exec

# Historical Google Orders Spreadsheet ID (Read-only archive for legacy orders)
ORDERS_SPREADSHEET_ID=16R6KiGoNgH31qEJxCiKrNTD2u99TKHJfDlzgb6iH_nw

# ------------------------------------------------------------------------------
# 6. CAMPUS ADS & DRIVE ASSETS (ISOLATED FROM ORDERS MIGRATION)
# ------------------------------------------------------------------------------
# Campus Ads Google Spreadsheet ID
ADS_SPREADSHEET_ID=1a_dzI0AaOQo0gypw00BUUiKC872a7lKbKNQU4qe-Eq4

# Campus Ads Google Drive Folder ID
ADS_DRIVE_FOLDER_ID=1HQ_WklATac1JXXpVOzQ40r_X9AClORGo

# Google Drive Folders for Orders (Drive staging)
PDF_FOLDER_ID=1QRJ-c9wDYJJoDpflTdhkZ91rcjVBgswF
SCREENSHOT_FOLDER_ID=13aksBYQ3sRnMh_oFKTAXagUr4h7xMD9E
